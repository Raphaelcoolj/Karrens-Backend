MONGODB_URL=mongodb://localhost:27017/karren

GROQ_API_KEY=REPLACE_WITH_YOUR_GROQ_KEY
MISTRAL_API_KEY=REPLACE_WITH_YOUR_MISTRAL_KEY

CLOUDINARY_CLOUD_NAME=REPLACE_WITH_YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=REPLACE_WITH_YOUR_API_KEY
CLOUDINARY_API_SECRET=REPLACE_WITH_YOUR_API_SECRET

AI_PRIMARY_PROVIDER=groq
AI_FALLBACK_PROVIDER=mistral

TWELVE_DATA_API_KEY=REPLACE_WITH_YOUR_TWELVE_DATA_KEY

CORS_ORIGINS=["http://localhost:3000"]

# Web Push VAPID (required for notifications)
# Generate keys: npx web-push generate-vapid-keys
# Private key stays on backend only - never expose to frontend
VAPID_PRIVATE_KEY=REPLACE_WITH_YOUR_VAPID_PRIVATE_KEY
VAPID_PUBLIC_KEY=REPLACE_WITH_YOUR_VAPID_PUBLIC_KEY
VAPID_SUBJECT=mailto:your-email@example.com
